const TimeEntryScreen = ({ navigation, route }) => {
  // Zde bude později načítání dat z API
  const timeEntry = {
    id: route.params?.id || 1,
    description: "Ukázkový časový záznam",
    startTime: "2024-04-30T09:00:00",
    endTime: "2024-04-30T11:30:00",
    project: { name: "Projekt XYZ" },
    isBillable: true,
    durationInHours: 2.5
  };

  return (
    <View style={styles.container}>
      <View style={styles.card}>
        <Text style={styles.projectName}>{timeEntry.project.name}</Text>

        <View style={styles.infoRow}>
          <Text style={styles.label}>Začátek:</Text>
          <Text style={styles.value}>{new Date(timeEntry.startTime).toLocaleString()}</Text>
        </View>

        <View style={styles.infoRow}>
          <Text style={styles.label}>Konec:</Text>
          <Text style={styles.value}>
            {timeEntry.endTime ? new Date(timeEntry.endTime).toLocaleString() : 'Stále běží'}
          </Text>
        </View>

        <View style={styles.infoRow}>
          <Text style={styles.label}>Trvání:</Text>
          <Text style={styles.value}>
            {timeEntry.durationInHours ? `${timeEntry.durationInHours} hodin` : '-'}
          </Text>
        </View>

        <View style={styles.infoRow}>
          <Text style={styles.label}>Fakturovatelné:</Text>
          <Text style={styles.value}>
            {timeEntry.isBillable ? 'Ano' : 'Ne'}
          </Text>
        </View>

        {timeEntry.description && (
          <View style={styles.descriptionContainer}>
            <Text style={styles.label}>Popis:</Text>
            <Text style={styles.description}>{timeEntry.description}</Text>
          </View>
        )}

        <View style={styles.buttonsContainer}>
          <TouchableOpacity
            style={[styles.button, styles.editButton]}
            onPress={() => {
              // Zde bude později navigace na úpravu
              alert('Úprava záznamu');
            }}
          >
            <Text style={styles.buttonText}>Upravit</Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={[styles.button, styles.deleteButton]}
            onPress={() => {
              // Zde bude později mazání záznamu
              alert('Mazání záznamu');
              navigation.goBack();
            }}
          >
            <Text style={styles.buttonText}>Smazat</Text>
          </TouchableOpacity>
        </View>
      </View>
    </View>
  );
};

